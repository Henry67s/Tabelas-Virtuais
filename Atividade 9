
-- ============================================================
-- 3º PASSO - CRIAR E POPULAR A TABELA DE ENTREGAS
-- ============================================================

IF OBJECT_ID('entregas', 'U') IS NULL
BEGIN
    CREATE TABLE entregas (
        id INT IDENTITY(1,1) PRIMARY KEY,
        id_pedido INT NOT NULL,
        data_entrega DATE NOT NULL,
        status VARCHAR(20) NOT NULL,
        valor_frete DECIMAL(10,2) NOT NULL,
        FOREIGN KEY (id_pedido) REFERENCES pedidos(id)
    );
END
GO

-- Índice de desempenho por status
IF NOT EXISTS (
    SELECT 1 FROM sys.indexes
    WHERE name = 'idx_status_entrega' AND object_id = OBJECT_ID('entregas')
)
BEGIN
    CREATE INDEX idx_status_entrega ON entregas(status);
END
GO

