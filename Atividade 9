-- ============================================================
-- 4º PASSO - CRIAR AS TABELAS VIRTUAIS (VIEWS)
-- ============================================================

-- VIEW 1 - RESUMO DAS ENTREGAS
-- Apresenta o total de entregas e a média dos valores de frete.

IF OBJECT_ID('vw_resumo_entregas', 'V') IS NOT NULL
    DROP VIEW vw_resumo_entregas;
GO

CREATE VIEW vw_resumo_entregas
AS
SELECT
    COUNT(*) AS total_entregas,
    AVG(valor_frete) AS media_valor_frete
FROM entregas;
GO

-- VIEW 2 - ENTREGAS CONCLUÍDAS
-- Mostra somente as entregas com status "Entregue".
-- Utiliza INNER JOIN entre entregas e pedidos.

IF OBJECT_ID('vw_entregas_concluidas', 'V') IS NOT NULL
    DROP VIEW vw_entregas_concluidas;
GO

CREATE VIEW vw_entregas_concluidas
AS
SELECT
    e.id_pedido AS id_pedido,
    p.valor AS valor_pedido,
    e.valor_frete AS valor_frete,
    e.data_entrega AS data_entrega
FROM entregas AS e
INNER JOIN pedidos AS p
    ON e.id_pedido = p.id
WHERE e.status = 'Entregue';
GO

-- ============================================================
-- CONSULTA DAS VIEWS
-- ============================================================

-- Consulta da View 1
SELECT *
FROM vw_resumo_entregas;
GO

-- Consulta da View 2
SELECT *
FROM vw_entregas_concluidas;
GO

